# ==============================================================================
# Wzor pliku zmiennych (terraform.tfvars.example)
# Skopiuj ten plik jako terraform.tfvars i dostosuj wartosci:
#   cp terraform.tfvars.example terraform.tfvars
# ==============================================================================

# Region chmury AWS (np. eu-central-1, eu-west-1)
aws_region = "eu-central-1"

# Identyfikator projektu
project_name = "beauty-salon-app"

# Nazwa srodowiska
environment = "production"

# Konfiguracja sieciowa VPC
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
availability_zone  = "eu-central-1a"

# Zasoby serwera EC2
instance_type    = "t3.small"
root_volume_size = 20

# Sciezka do Twojego lokalnego klucza publicznego SSH (~/.ssh/id_ed25519.pub lub ~/.ssh/id_rsa.pub)
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Pula adresow z dostepem do portu SSH (22)
allowed_ssh_cidrs = ["0.0.0.0/0"]
