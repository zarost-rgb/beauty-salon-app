{
  "name": "beauty-salon-backend",
  "version": "1.0.0",
  "description": "REST API backend for Beauty Salon App (Bellezza Studio)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "keywords": [
    "beauty-salon",
    "express",
    "postgresql",
    "devops",
    "prometheus",
    "rest-api"
  ],
  "author": "Ross DevOps Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
